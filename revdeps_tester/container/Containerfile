# This Containerfile contains several stages:
#
#     runtime-platform: Fedora base image with the required dependencies
#     added on top to run revdeps_tester.
#
#     production: Official goose builds installed on top of runtime-platform
#
#     source-build: Fedora base image with revdeps_tester built from
#     git on top. It applies all the patches in revdeps_tester/container
#     as well. This is useful for instrumenting revdeps_tester with
#     extra debug logging, etc.
#
#     debug: Custom built goose installed on top of runtime-platform
#     This is useful for trying out the instrumented revdeps_tester builds.

ARG BASE_IMAGE=registry.fedoraproject.org/fedora:42
ARG GOOSE_VERSION=v1.1.3

#
# runtime-platform: Fedora base image with the required dependencies to added to
# run revdeps_tester.
#
FROM ${BASE_IMAGE} AS runtime-platform

RUN dnf install -y \
        libxcb \
        python3 \
        gh \
        glab \
        rpmbuild \
        spectool \
        rpmlint \
        centpkg \
        wget

RUN useradd -m -G wheel revdeps_tester \
 && echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd \
 && mkdir -p /home/revdeps_tester/.config/revdeps_tester /home/revdeps_tester/recipes /home/revdeps_tester/scripts \
 && chown -R revdeps_tester:revdeps_tester /home/revdeps_tester

COPY --chown=revdeps_tester:revdeps_tester \
     revdeps_tester/container/goose-config.yaml \
     /home/revdeps_tester/.config/revdeps_tester/config.yaml
COPY --chown=revdeps_tester:revdeps_tester \
     revdeps_tester/recipes/ \
     /home/revdeps_tester/recipes/
COPY --chown=revdeps_tester:revdeps_tester \
     revdeps_tester/scripts/ \
     /home/revdeps_tester/scripts/

USER revdeps_tester
WORKDIR /home/revdeps_tester

#
# production: Official revdeps_tester builds installed on top of runtime-platform
#
FROM runtime-platform AS production

USER root

ARG GOOSE_VERSION

RUN curl -fsSL https://github.com/block/goose/releases/download/${GOOSE_VERSION}/download_cli.sh | \
    GOOSE_BIN_DIR=/usr/local/bin CONFIGURE=false bash

USER revdeps_tester

ENTRYPOINT ["/usr/local/bin/goose"]

FROM ${BASE_IMAGE} AS source-build

RUN dnf install -y \
        git \
        rust \
        cargo \
        protobuf-compiler \
        protobuf-devel \
        libxcb-devel

ARG GOOSE_REPO=https://github.com/block/goose.git
ARG GOOSE_VERSION

WORKDIR /usr/src
RUN git clone --depth 1 \
    --branch "${GOOSE_VERSION}" \
    "${GOOSE_REPO}" \
    goose-src

WORKDIR /usr/src/goose-src
COPY revdeps_tester/container/*.patch patches/

RUN cargo fetch --locked

RUN git config --global user.email "rhel-packaging-agent@redhat.com" \
 && git config --global user.name "RHEL Packaging Agent"

RUN cargo build --release -p goose-cli

RUN git am --empty=drop patches/*.patch \
 && cargo build --release -p goose-cli

#
# debug: Custom built revdeps_tester installed on top of runtime-platform
#
FROM runtime-platform AS debug
COPY --from=source-build /usr/src/goose-src/target/release/goose /usr/local/bin/goose

ENTRYPOINT ["/usr/bin/bash"]
CMD ["-c", ". ~/.bashrc; /usr/local/bin/goose"]
